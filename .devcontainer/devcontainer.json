{
  "postAttachCommand": "find /tmp -maxdepth 1 -type s -name 'vscode-ssh-auth-*.sock' -delete",
  "name": "mgb-ops",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "rafbar",
  "containerUser": "rafbar",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "PATH": "/home/rafbar/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "zknpr.sqlite-explorer"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -e .[dev,data,forecast,geo]"
}
